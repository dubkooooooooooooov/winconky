<Window x:Class="winconky.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay" Height="656" Width="423"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Black"
        Opacity="0.7"
        Topmost="False"
        ShowInTaskbar="False">
    <StackPanel Margin="10">
        <!-- System name-->
        <TextBlock x:Name="SystemNameText" FontFamily="Consolas" FontSize="22" Foreground="Cyan" TextAlignment="Center" Margin="15,15,15,0"/>

        <!-- Uptime-->
        <TextBlock x:Name="UptimeText" FontFamily="Consolas" FontSize="20" Foreground="LightGray" Margin="10,10,10,0"/>
        
        <!-- RAM -->
        <TextBlock x:Name="RamText" FontFamily="Consolas" FontSize="20" Foreground="LightGray" Margin="10,10,10,0"/>
        <ProgressBar x:Name="RamBar" Height="10" Maximum="100" Margin="10,10,10,0"/>

        <!-- CPU -->
        <TextBlock x:Name="CpuText" FontFamily="Consolas" FontSize="20" Foreground="LightGray" Margin="10,10,10,0"/>
        <ProgressBar x:Name="CpuBar" Height="10" Maximum="100" Margin="10,10,10,10"/>

        <!-- Process list header -->
        <TextBlock Text="Name                CPU%    MEM%" 
           Foreground="White" FontFamily="Consolas" FontSize="20" Margin="10,30,10,0"/>

        <!-- Process list -->
        <ItemsControl x:Name="ProcessList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" 
                           Foreground="LightGray" FontFamily="Consolas" FontSize="18" Margin="10,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Cpu}" 
                           Foreground="LightGray" FontFamily="Consolas" FontSize="18" Margin="10,0,10,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding Mem}" 
                           Foreground="LightGray" FontFamily="Consolas" FontSize="18" Margin="10,0,10,0"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="CryptoText"
           Foreground="LightGray"
           FontFamily="Consolas"
           FontSize="20"
           Margin="10,30,10,0"
           Text="Loading..."/>
        <TextBlock x:Name="CryptoUpdatedText" Foreground="LightGray" FontSize="16" Margin="10,5,10,10"/>
    </StackPanel>
</Window>